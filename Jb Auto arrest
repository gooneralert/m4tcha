-- Anchoring all Helper Functions directly in standard environmental GLOBALS to prevent VM stack sweepers from clearing them
function getPath(parent, ...)
    local current = parent
    for _, name in ipairs({...}) do
        if not current then return nil end
        current = current:FindFirstChild(name)
    end
    return current
end

