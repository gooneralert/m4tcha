end

-- Smart Equipment Manager: Checks Hotbar item sizes to precisely equip necessary tools
function equipTool(slotIndex)
    local targetStr = tostring(slotIndex)
    local vKey = 0x30 + tonumber(slotIndex) -- Virtual Key Code for numbers (0x31 = 1, 0x32 = 2...)
    
    for attempt = 1, 3 do
        local playerGui = player:FindFirstChildOfClass("PlayerGui") or player:FindFirstChild("PlayerGui")
        local container = playerGui and getPath(playerGui, "HotbarGui", "Container")
        
        if not container then
            tapKey(vKey)
            wait(0.3)
            return false
        end
        
        local items = {}
        local maxArea = 0
        local minArea = 999999999
        
        -- Safely map only valid "Item" objects
        for _, child in ipairs(container:GetChildren()) do
            if child.Name == "Item" then
                local success, size = pcall(function() return child.AbsoluteSize end)
                if success and size then
                    local sx = tonumber(size.X) or 0
                    local sy = tonumber(size.Y) or 0
                    local area = sx * sy
                    
                    if area > 0 then
                        local btn = child:FindFirstChild("Button")
                        local idxObj = btn and btn:FindFirstChild("Index")
                        local itemIndex = "None"
                        
                        if idxObj then
                            local tSuccess, tVal = pcall(function() return idxObj.Text end)
                            if tSuccess and tVal then
                                itemIndex = tostring(tVal):match("%d+") or "None"
                            end
                        end
                        
                        table.insert(items, {area = area, index = itemIndex})
                        if area > maxArea then maxArea = area end
                        if area < minArea then minArea = area end
                    end
                end
            end
        end
        
        local activeIndex = "None"
        
        -- If max size is notably bigger than min size (by >5%), something is currently scaled up (equipped)
        if maxArea > (minArea * 1.05) then
            for _, data in ipairs(items) do
                if data.area >= (maxArea * 0.95) then
                    activeIndex = data.index
                    break
                end
            end
        end
        
        -- Success match, exit immediately
        if activeIndex == targetStr then
            return true 
        end
        
        -- Not equipped or nothing is equipped, so tap the key to toggle it
        tapKey(vKey)
        wait(0.3) -- Wait for the UI to animate and the tool to draw
    end
    return false
end

