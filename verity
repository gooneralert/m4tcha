local VerityId = tick()
_G.VeritySmiley = VerityId

if _G.VeritySmileyCleanup then
    _G.VeritySmileyCleanup()
end

local Settings = {
    Enabled = true,
    LowGraphics = true,
    Quality = 3,
    Color = Color3.fromRGB(255, 230, 0),
    FaceColor = Color3.fromRGB(0, 0, 0),
    Radius = 1.3,
    Transparency = 1,
    Thickness = 5.5
}

local Cache = {
    Triangles = {},
    Lines = {},
    Circles = {}
}

local Counts = {
    Triangles = 0,
    Lines = 0,
    Circles = 0
}

_G.VeritySmileyCleanup = function()
    for _, group in pairs(Cache) do
        for i = 1, #group do
            local item = group[i]
            if item then
                pcall(function()
                    item.Visible = false
                    item:Remove()
                end)
            end
        end
    end
    Cache = { Triangles = {}, Lines = {}, Circles = {} }
    Counts = { Triangles = 0, Lines = 0, Circles = 0 }
end

local function GetDrawing(type, index)
    local list = Cache[type]
    if not list[index] then
        local ok, obj = pcall(Drawing.new, type == "Triangles" and "Triangle" or (type == "Lines" and "Line" or "Circle"))
        if ok and obj then
            list[index] = obj
        else
            return nil
        end
    end
    return list[index]
end

local function Render(cf, camPos)
    local pos = cf.Position
    local look = cf.LookVector
    local right = cf.RightVector
    local up = cf.UpVector

    local triCount = 0
    local lineCount = 0
    local circleCount = 0
    local radius = Settings.Radius

    local quality = math.max(1, math.floor(Settings.Quality))
    local latSteps = 6 + quality * 4
    local lonSteps = 10 + quality * 6

    local mesh = {}
    for i = 0, latSteps do
        mesh[i] = {}
        local lat = (i / latSteps) * math.pi - (math.pi / 2)
        local y = math.sin(lat) * radius
        local r = math.cos(lat) * radius
        for j = 0, lonSteps - 1 do
            local lon = (j / lonSteps) * (math.pi * 2)
            local x = math.cos(lon) * r
            local z = math.sin(lon) * r
            local world = pos + (right * x) + (up * y) + (look * z)
            local screen, onScreen = WorldToScreen(world)
            mesh[i][j] = {
                World = world,
                Screen = onScreen and Vector2.new(screen.X, screen.Y) or nil
            }
        end
    end

    for i = 0, latSteps - 1 do
        for j = 0, lonSteps - 1 do
            local nextJ = (j + 1) % lonSteps
            local v00 = mesh[i][j]
            local v01 = mesh[i][nextJ]
            local v10 = mesh[i + 1][j]
            local v11 = mesh[i + 1][nextJ]

            local t1A, t1B, t1C = v00, v10, v11
            if t1A.Screen and t1B.Screen and t1C.Screen then
                local center = (t1A.World + t1B.World + t1C.World) / 3
                local norm = (center - pos).Unit
                local toCam = camPos - center

                if norm:Dot(toCam) > 0 then
                    triCount = triCount + 1
                    local tri = GetDrawing("Triangles", triCount)
                    if tri then
                        if Settings.LowGraphics then
                            tri.PointA = t1A.Screen
                            tri.PointB = t1B.Screen
                            tri.PointC = t1C.Screen
                        else
                            local pA, pB, pC = t1A.Screen, t1B.Screen, t1C.Screen
                            local mX = (pA.X + pB.X + pC.X) / 3
                            local mY = (pA.Y + pB.Y + pC.Y) / 3

                            local dAx, dAy = pA.X - mX, pA.Y - mY
                            local lenA = math.sqrt(dAx * dAx + dAy * dAy)
                            local outA = lenA > 0 and Vector2.new(pA.X + (dAx / lenA) * 0.75, pA.Y + (dAy / lenA) * 0.75) or pA

                            local dBx, dBy = pB.X - mX, pB.Y - mY
                            local lenB = math.sqrt(dBx * dBx + dBy * dBy)
                            local outB = lenB > 0 and Vector2.new(pB.X + (dBx / lenB) * 0.75, pB.Y + (dBy / lenB) * 0.75) or pB

                            local dCx, dCy = pC.X - mX, pC.Y - mY
                            local lenC = math.sqrt(dCx * dCx + dCy * dCy)
                            local outC = lenC > 0 and Vector2.new(pC.X + (dCx / lenC) * 0.75, pC.Y + (dCy / lenC) * 0.75) or pC

                            tri.PointA = outA
                            tri.PointB = outB
                            tri.PointC = outC
                        end
                        tri.Color = Settings.Color
                        tri.Filled = true
                        tri.Transparency = Settings.Transparency
                        tri.ZIndex = 5
                        tri.Visible = true
                    end
                end
            end

            local t2A, t2B, t2C = v00, v11, v01
            if t2A.Screen and t2B.Screen and t2C.Screen then
                local center = (t2A.World + t2B.World + t2C.World) / 3
                local norm = (center - pos).Unit
                local toCam = camPos - center

                if norm:Dot(toCam) > 0 then
                    triCount = triCount + 1
                    local tri = GetDrawing("Triangles", triCount)
                    if tri then
                        if Settings.LowGraphics then
                            tri.PointA = t2A.Screen
                            tri.PointB = t2B.Screen
                            tri.PointC = t2C.Screen
                        else
                            local pA, pB, pC = t2A.Screen, t2B.Screen, t2C.Screen
                            local mX = (pA.X + pB.X + pC.X) / 3
                            local mY = (pA.Y + pB.Y + pC.Y) / 3

                            local dAx, dAy = pA.X - mX, pA.Y - mY
                            local lenA = math.sqrt(dAx * dAx + dAy * dAy)
                            local outA = lenA > 0 and Vector2.new(pA.X + (dAx / lenA) * 0.75, pA.Y + (dAy / lenA) * 0.75) or pA

                            local dBx, dBy = pB.X - mX, pB.Y - mY
                            local lenB = math.sqrt(dBx * dBx + dBy * dBy)
                            local outB = lenB > 0 and Vector2.new(pB.X + (dBx / lenB) * 0.75, pB.Y + (dBy / lenB) * 0.75) or pB

                            local dCx, dCy = pC.X - mX, pC.Y - mY
                            local lenC = math.sqrt(dCx * dCx + dCy * dCy)
                            local outC = lenC > 0 and Vector2.new(pC.X + (dCx / lenC) * 0.75, pC.Y + (dCy / lenC) * 0.75) or pC

                            tri.PointA = outA
                            tri.PointB = outB
                            tri.PointC = outC
                        end
                        tri.Color = Settings.Color
                        tri.Filled = true
                        tri.Transparency = Settings.Transparency
                        tri.ZIndex = 5
                        tri.Visible = true
                    end
                end
            end
        end
    end

    local eyeSpacing = { -0.34 * radius, 0.34 * radius }
    local eyeY = 0.22 * radius
    local eyeRx = 0.10 * radius
    local eyeRy = 0.18 * radius
    local eyeSteps = 8 + quality * 2

    for e = 1, 2 do
        local ecx = eyeSpacing[e]
        local ecy = eyeY
        local ecz = math.sqrt(math.max(0.01, (radius * radius) - (ecx * ecx) - (ecy * ecy)))
        local centerWorld = pos + (right * ecx) + (up * ecy) + (look * ecz) * 1.015
        local eyeNorm = (centerWorld - pos).Unit

        if eyeNorm:Dot(camPos - centerWorld) > 0 then
            local centerScreen, centerOn = WorldToScreen(centerWorld)
            if centerOn then
                local centerPoint = Vector2.new(centerScreen.X, centerScreen.Y)
                local prevScreen = nil

                for k = 0, eyeSteps do
                    local ang = (k / eyeSteps) * math.pi * 2
                    local px = ecx + math.cos(ang) * eyeRx
                    local py = ecy + math.sin(ang) * eyeRy
                    local pz = math.sqrt(math.max(0.01, (radius * radius) - (px * px) - (py * py)))
                    local pw = pos + (right * px) + (up * py) + (look * pz) * 1.015
                    local pScreen, pOn = WorldToScreen(pw)
                    local curScreen = pOn and Vector2.new(pScreen.X, pScreen.Y) or nil

                    if prevScreen and curScreen then
                        triCount = triCount + 1
                        local tri = GetDrawing("Triangles", triCount)
                        if tri then
                            tri.PointA = centerPoint
                            tri.PointB = prevScreen
                            tri.PointC = curScreen
                            tri.Color = Settings.FaceColor
                            tri.Filled = true
                            tri.Transparency = Settings.Transparency
                            tri.ZIndex = 6
                            tri.Visible = true
                        end
                    end
                    prevScreen = curScreen
                end
            end
        end
    end

    local smileSteps = 16 + quality * 4
    local prevSmile = nil
    local capRadius = Settings.Thickness / 2

    for s = 0, smileSteps do
        local t = (s / smileSteps) * 2 - 1
        local sx = t * 0.60 * radius
        local sy = (-0.46 + 0.32 * (t * t)) * radius
        local sz = math.sqrt(math.max(0.01, (radius * radius) - (sx * sx) - (sy * sy)))
        local sw = pos + (right * sx) + (up * sy) + (look * sz) * 1.015
        local smileNorm = (sw - pos).Unit

        local curSmile = nil
        if smileNorm:Dot(camPos - sw) > 0 then
            local sp, onScreen = WorldToScreen(sw)
            if onScreen then
                curSmile = Vector2.new(sp.X, sp.Y)
                if not Settings.LowGraphics then
                    circleCount = circleCount + 1
                    local circle = GetDrawing("Circles", circleCount)
                    if circle then
                        circle.Position = curSmile
                        circle.Radius = capRadius
                        circle.Color = Settings.FaceColor
                        circle.Filled = true
                        circle.Transparency = Settings.Transparency
                        circle.ZIndex = 6
                        circle.Visible = true
                    end
                end
            end
        end

        if prevSmile and curSmile then
            lineCount = lineCount + 1
            local line = GetDrawing("Lines", lineCount)
            if line then
                line.From = prevSmile
                line.To = curSmile
                line.Color = Settings.FaceColor
                line.Thickness = Settings.Thickness
                line.Transparency = Settings.Transparency
                line.ZIndex = 6
                line.Visible = true
            end
        end
        prevSmile = curSmile
    end

    local capSides = { -1, 1 }
    local tickLen = 0.08 * radius

    for c = 1, 2 do
        local side = capSides[c]
        local cx = side * 0.60 * radius
        local cy = (-0.46 + 0.32) * radius
        local cz = math.sqrt(math.max(0.01, (radius * radius) - (cx * cx) - (cy * cy)))
        local capCenter = pos + (right * cx) + (up * cy) + (look * cz) * 1.015
        local capNorm = (capCenter - pos).Unit

        if capNorm:Dot(camPos - capCenter) > 0 then
            local dx = -side * 0.729 * tickLen
            local dy = 0.684 * tickLen

            local p1x = cx - dx
            local p1y = cy - dy
            local p1z = math.sqrt(math.max(0.01, (radius * radius) - (p1x * p1x) - (p1y * p1y)))

            local p2x = cx + dx
            local p2y = cy + dy
            local p2z = math.sqrt(math.max(0.01, (radius * radius) - (p2x * p2x) - (p2y * p2y)))

            local p1w = pos + (right * p1x) + (up * p1y) + (look * p1z) * 1.015
            local p2w = pos + (right * p2x) + (up * p2y) + (look * p2z) * 1.015

            local sp1, on1 = WorldToScreen(p1w)
            local sp2, on2 = WorldToScreen(p2w)

            if on1 and on2 then
                local v1 = Vector2.new(sp1.X, sp1.Y)
                local v2 = Vector2.new(sp2.X, sp2.Y)

                lineCount = lineCount + 1
                local line = GetDrawing("Lines", lineCount)
                if line then
                    line.From = v1
                    line.To = v2
                    line.Color = Settings.FaceColor
                    line.Thickness = Settings.Thickness
                    line.Transparency = Settings.Transparency
                    line.ZIndex = 6
                    line.Visible = true
                end

                if not Settings.LowGraphics then
                    circleCount = circleCount + 1
                    local c1 = GetDrawing("Circles", circleCount)
                    if c1 then
                        c1.Position = v1
                        c1.Radius = capRadius
                        c1.Color = Settings.FaceColor
                        c1.Filled = true
                        c1.Transparency = Settings.Transparency
                        c1.ZIndex = 6
                        c1.Visible = true
                    end

                    circleCount = circleCount + 1
                    local c2 = GetDrawing("Circles", circleCount)
                    if c2 then
                        c2.Position = v2
                        c2.Radius = capRadius
                        c2.Color = Settings.FaceColor
                        c2.Filled = true
                        c2.Transparency = Settings.Transparency
                        c2.ZIndex = 6
                        c2.Visible = true
                    end
                end
            end
        end
    end

    local triList = Cache.Triangles
    for i = triCount + 1, Counts.Triangles do
        local tri = triList[i]
        if tri then tri.Visible = false end
    end
    Counts.Triangles = triCount

    local lineList = Cache.Lines
    for i = lineCount + 1, Counts.Lines do
        local line = lineList[i]
        if line then line.Visible = false end
    end
    Counts.Lines = lineCount

    local circleList = Cache.Circles
    for i = circleCount + 1, Counts.Circles do
        local circle = circleList[i]
        if circle then circle.Visible = false end
    end
    Counts.Circles = circleCount
end

task.spawn(function()
    local RunService = game:GetService("RunService")
    local Players = game:GetService("Players")
    local Workspace = game:GetService("Workspace")

    RunService.RenderStepped:Connect(function()
        if _G.VeritySmiley ~= VerityId then return end

        if not Settings.Enabled then
            for type, max in pairs(Counts) do
                local list = Cache[type]
                for i = 1, max do
                    if list[i] then list[i].Visible = false end
                end
                Counts[type] = 0
            end
            return
        end

        local lp = Players.LocalPlayer
        if not lp then return end
        local character = lp.Character
        if not character then return end
        local head = character:FindFirstChild("Head")
        if not head then return end

        local camera = Workspace.CurrentCamera
        local camPos = camera and camera.Position or head.Position

        Render(head.CFrame, camPos)
    end)
end)
