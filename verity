end

_G.VerityCleanup = function()
    for _, group in pairs(Cache) do
        for i = 1, #group do
            local item = group[i]
            if item then
                pcall(function()
                    item.Visible = false
                    item:Remove()
                end)
            end
        end
    end
    Cache = { Triangles = {}, Lines = {}, Circles = {} }
    Counts = { Triangles = 0, Lines = 0, Circles = 0 }

    for i = 1, #Cleanups do
        local item = Cleanups[i]
        if item then
            pcall(function()
                item.Visible = false
                item:Remove()
            end)
        end
    end
    Cleanups = {}
end

