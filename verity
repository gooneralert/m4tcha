local function FindPlayerFolder(ws)
    local ok, res = pcall(function()
        local wsPlayers = ws:FindFirstChild("Players")
        if not wsPlayers then
            local gameFolder = ws:FindFirstChild("Game")
            if gameFolder then
                wsPlayers = gameFolder:FindFirstChild("Players")
            end
        end
        return wsPlayers
    end)
    return ok and res or nil
end

local function FindPlayerModel(folder, lp)
    if not folder or not lp then return nil end
    local m = folder:FindFirstChild(lp.Name)
    if not m and lp.DisplayName then
        m = folder:FindFirstChild(lp.DisplayName)
    end
    if not m then
        local children = folder:GetChildren()
        for i = 1, #children do
            if string.lower(children[i].Name) == string.lower(lp.Name) then
                return children[i]
            end
        end
    end
    return m
end

local CachedPlayerInfo = nil
local LastPlayerInfoCheck = 0

local function GetPlayerInfo()
    local now = tick()
    if CachedPlayerInfo and (now - LastPlayerInfoCheck < 0.25) then
        local anchorPart = CachedPlayerInfo.Anchor
        if anchorPart and anchorPart.Parent then
            local pos = anchorPart.Position
            local cf = anchorPart.CFrame
            if CachedPlayerInfo.IsOffset then
                pos = Vector3.new(pos.X, pos.Y + 2.7, pos.Z)
                local okC, r00, r01, r02, r10, r11, r12, r20, r21, r22 = pcall(function()
                    local _, _, _, a, b, c, d, e, f, g, h, i = anchorPart.CFrame:GetComponents()
                    return a, b, c, d, e, f, g, h, i
                end)
                if okC and r00 then
                    cf = CFrame.new(pos.X, pos.Y, pos.Z, r00, r01, r02, r10, r11, r12, r20, r21, r22)
                else
                    cf = CFrame.new(pos.X, pos.Y, pos.Z)
                end
            end
            local _, yaw, _ = cf:ToOrientation()
            CachedPlayerInfo.Position = pos
            CachedPlayerInfo.CFrame = cf
            CachedPlayerInfo.LookVector = cf.LookVector
            CachedPlayerInfo.Yaw = yaw
            return CachedPlayerInfo
        end
    end
    LastPlayerInfoCheck = now

    local lp = game:GetService("Players").LocalPlayer
    if not lp then return nil end

    local okP, pId = pcall(function() return game.PlaceId end)
    local okG, gId = pcall(function() return game.GameId end)
    local isSpecialPlace = ((okP and pId == 9872472334) or (okG and gId == 9872472334))

    local char = nil
    local anchorPart = nil

    if isSpecialPlace then
        local ws = game:GetService("Workspace")
        local wsPlayers = FindPlayerFolder(ws)
        if wsPlayers then
            char = FindPlayerModel(wsPlayers, lp)
        end
        if not char then
            char = lp.Character
        end

        if char then
            local rightLeg = char:FindFirstChild("Right Leg") or char:FindFirstChild("RightLowerLeg")
            if rightLeg then
                anchorPart = rightLeg
            else
                anchorPart = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head") or char.PrimaryPart
            end
        end
    else
        char = lp.Character
        if char then
            anchorPart = char:FindFirstChild("Head")
        end
    end

    if not char or not anchorPart then return nil end

    local root = char:FindFirstChild("HumanoidRootPart") or anchorPart
    local hum = char:FindFirstChildOfClass("Humanoid") or (char:FindFirstChild("Humanoid") and char.Humanoid)

    local cf = anchorPart.CFrame
    local pos = anchorPart.Position
    local isOffset = isSpecialPlace and (anchorPart.Name == "Right Leg" or anchorPart.Name == "RightLowerLeg")

    if isOffset then
        pos = Vector3.new(pos.X, pos.Y + 2.7, pos.Z)
        local okC, r00, r01, r02, r10, r11, r12, r20, r21, r22 = pcall(function()
            local _, _, _, a, b, c, d, e, f, g, h, i = anchorPart.CFrame:GetComponents()
            return a, b, c, d, e, f, g, h, i
        end)
        if okC and r00 then
            cf = CFrame.new(pos.X, pos.Y, pos.Z, r00, r01, r02, r10, r11, r12, r20, r21, r22)
        else
            cf = CFrame.new(pos.X, pos.Y, pos.Z)
        end
    end

    local _, yaw, _ = cf:ToOrientation()
    local look = cf.LookVector

    CachedPlayerInfo = {
        Character = char,
        Anchor = anchorPart,
        Root = root,
        Humanoid = hum,
        CFrame = cf,
        Position = pos,
        LookVector = look,
        Yaw = yaw,
        IsOffset = isOffset
    }
    return CachedPlayerInfo
end

