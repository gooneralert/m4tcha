-- Main Physics Loop
task.spawn(function()
    while true do
        wait(0.016)
        if not S.enabled then continue end
        local currentTick = tonumber(tick()) or 0

        -- Fetch Character Root
        local myChar = player.Character
        local myRoot = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar.PrimaryPart)
        
        -- Continuous Death & Respawn transition checker (Dynamic Post-Death Route Multi-Selector)
        local humanoid = myChar and myChar:FindFirstChildOfClass("Humanoid")
        if humanoid then
            if humanoid.Health == 0 then
                if not S.isDeadState then
                    S.isDeadState = true
                    S.needsRespawnSequence = true
                    S.respawnTime = 0 -- Reset respawn timestamp
                end
            else
                if S.isDeadState then
                    -- Transition Event: Character went from 0 health to alive (loaded back in)
                    S.isDeadState = false
                    S.respawnTime = tonumber(tick()) or 0 -- Lock actual spawn loading moment
                end
                
                if S.needsRespawnSequence then
                    local spawnTime = tonumber(S.respawnTime) or 0
                    
                    -- Dynamic Settle Delay: Wait exactly 0.5 seconds for game server coordinates to teleport you and settle
                    if spawnTime > 0 and (currentTick - spawnTime > 0.5) then
                        if myRoot and myRoot.Position then
                            S.needsRespawnSequence = false -- Consume flag
                            
                            local myPos = myRoot.Position
                            
                            -- Setup target start points of your 5 recovery exits
                            local r1Start = Vector3.new(1750.4, 24.83, -4008.74)
                            local r2Start = Vector3.new(-1131.70, 18.85, -1587.14)
                            local r3Start = Vector3.new(725.65, 44.95, 1084.91)
                            local r4Start = Vector3.new(1826.70, 25.54, -871.26)
                            local r5Start = Vector3.new(-1145.17, 39.19, -1566.10)
                            
                            -- Determine distances to choose the closest police spawn point automatically (Y-axis hardened)
                            local routes = {
                                { start = r1Start, action = "spawn", skipGarage = false, waypoints = { r1Start, Vector3.new(1727.23, 23.50, -4009.02), Vector3.new(1750.4, 24.83, -3960.0) }, name = "Route 1" },
                                { start = r2Start, action = "spawn", skipGarage = false, waypoints = { r2Start, Vector3.new(-1105.05, 18.40, -1513.06) }, name = "Route 2" },
                                { start = r3Start, action = "find", skipGarage = true, waypoints = { r3Start }, name = "Route 3" },
                                { start = r4Start, action = "spawn", skipGarage = false, waypoints = { r4Start }, name = "Route 4" },
                                { start = r5Start, action = "spawn", skipGarage = false, waypoints = { r5Start, Vector3.new(-1112.57, 38.25, -1562.00) }, name = "Route 5" }
                            }
                            
                            local validRoutes = {}
                            for _, r in ipairs(routes) do
                                -- Discard vertically separated spawns (Y difference > 8 studs) to prevent downstairs/upstairs mismatches
                                local yDiff = math.abs(myPos.Y - r.start.Y)
                                if yDiff <= 8 then
                                    local dist = (myPos - r.start).Magnitude
                                    table.insert(validRoutes, { route = r, dist = dist })
                                end
                            end
                            
                            -- Proximity fallback
                            if #validRoutes == 0 then
                                for _, r in ipairs(routes) do
                                    local dist = (myPos - r.start).Magnitude
                                    table.insert(validRoutes, { route = r, dist = dist })
                                end
                            end
                            
                            table.sort(validRoutes, function(a, b)
                                return a.dist < b.dist
                            end)
                            
                            local chosen = validRoutes[1].route
                            S.deathRouteWaypoints = chosen.waypoints
                            S.deathRouteIndex = 1
                            S.deathRouteAction = chosen.action
                            S.skipGarageCheck = chosen.skipGarage
                            S.garageCooldownExpiry = 0 -- Unlock spawner
                            S.isWaitingAtWaypoint = false
                            S.waypointReachedTime = 0
                            
                            print(string.format("[CarFly Recovery] Respawn detected near %s. Initializing route...", chosen.name))
                            
                            S.respawnRoutingActive = true
                            S.isReturningToCar = false -- Suspend standard returns until waypoint flight is cleared
                        end
                    end
                end
            end
        end
        
        local car, carPart = getCarCached()
        local currentPos = nil

        -- Determine positioning anchor dynamically (Fall back to on-foot if not seated/found)
        if S.isArresting or S.isReturningToCar or S.respawnRoutingActive or not car then
            currentPos = myRoot and myRoot.Position
        else
            currentPos = carPart and carPart.Position
        end

        if not currentPos then 
            if S.statusLabel then
                S.statusLabel:SetText("Status: Waiting for vehicle or character...")
            end
            continue 
        end

        -- [NEW] Proximity Check (120 studs) exclusively for when we are returning to the car
        if S.isReturningToCar and not S.isCheckingGarage then
            local alt = getNearbyAlternativeTarget(currentPos, 120, S.targetPlayer)
            if alt then
                S.isReturningToCar = false
                S.targetPlayer = alt
                S.isArresting = true
                S.aligned = false
                S.lastDistanceToTarget = 999999999
                S.lastDistanceCheckTime = currentTick
                notify("Target found nearby! Hijacking chase: " .. alt.Name, "CarFly", 3)
                if S.targetLabel then
                    S.targetLabel:SetText("Target: " .. alt.Name)
                end
                continue
            end
        end

        local vx, vy, vz = 0, 0, 0

        -- Isolating variables defensively
        local activeHeight = tonumber(S.flyHeight) or 250
        local activeCarSpeed = tonumber(S.carSpeed) or 410
        local activePlayerSpeedH = tonumber(S.playerSpeedHorizontal) or 110
        local activePlayerSpeedV = tonumber(S.playerSpeedVertical) or 100
        local currentY = currentPos and tonumber(currentPos.Y) or 0

        -- Camera Lock Aimbot Loop (Fires continuously when S.isAimingTaser is active)
        if S.isAimingTaser and S.targetPlayer then
            local targetChar = S.targetPlayer.Character
            local targetRoot = targetChar and (targetChar:FindFirstChild("HumanoidRootPart") or targetChar.PrimaryPart)
            if targetRoot then
                local screenPos, onScreen = WorldToScreen(targetRoot.Position)
                if onScreen then
                    local mouseObj = player:GetMouse()
                    local mX = mouseObj.X
                    local mY = mouseObj.Y
                    -- Smooth project camera translation directly to target screen pixel position (Responsiveness factor: 3)
                    local diffX = (screenPos.X - mX) / 3
                    local diffY = (screenPos.Y - mY) / 3
                    pcall(mousemoverel, diffX, diffY)
                end
            end
        end

        -- Post-Death Waypoint Glide Controller with 0.5s Settle Waiting Block
        if S.respawnRoutingActive then
            local waypoints = S.deathRouteWaypoints or {}
            local index = S.deathRouteIndex or 1
            local targetWaypoint = waypoints[index]
            
            if not targetWaypoint then
                -- All recovery waypoints successfully cleared. Transition to spawner or closest-car intercept
                S.respawnRoutingActive = false
                S.isReturningToCar = true
                S.returnAscended = false
                S.returnAligned = false
                S.isWaitingAtWaypoint = false
                S.waypointReachedTime = 0
                continue
            end

            -- Dynamic Height Check: Ignore and skip ONLY this specific waypoint node if its Y coordinates exceed player Y by more than +5.0 studs
            if currentPos then
                local yDiff = targetWaypoint.Y - currentPos.Y
                if yDiff > 5 then
                    print(string.format("[CarFly Recovery] Dynamic Height bypass: Skipping Waypoint %d (Height delta of +%.2f exceeds limit of 5.0 studs)", index, yDiff))
                    S.deathRouteIndex = index + 1
                    S.isWaitingAtWaypoint = false
                    S.waypointReachedTime = 0
                    continue
                end
            end
            
            if S.isWaitingAtWaypoint then
                if S.statusLabel then
                    S.statusLabel:SetText(string.format("Status: Settle Pause at Waypoint %d/%d...", index, #waypoints))
                end
                
                -- Completely zero out velocity to stand still during the 0.5s settle delay
                if myRoot then
                    pcall(function()
                        myRoot.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        myRoot.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                    end)
                end
                
                local reachedTime = tonumber(S.waypointReachedTime) or 0
                if currentTick - reachedTime >= 0.5 then
                    -- 0.5 seconds elapsed! Progress to next waypoint
                    S.isWaitingAtWaypoint = false
                    S.waypointReachedTime = 0
                    S.deathRouteIndex = index + 1
                end
                continue
            end
            
            local dx = targetWaypoint.X - currentPos.X
            local dy = targetWaypoint.Y - currentPos.Y
            local dz = targetWaypoint.Z - currentPos.Z
            local distanceToWaypoint = math.sqrt(dx * dx + dy * dy + dz * dz)
            
            if distanceToWaypoint > 6 then
                if S.statusLabel then
                    S.statusLabel:SetText(string.format("Status: Respawning Flight Waypoint %d/%d...", index, #waypoints))
                end
                
                -- Move smoothly toward waypoint in 3D using velocity controls with deceleration clamping
                local direction = targetWaypoint - currentPos
                local flatDir = Vector3.new(direction.X, 0, direction.Z)
                local flatDist = flatDir.Magnitude
                
                local vxCent, vyCent, vzCent = 0, 0, 0
                if flatDist > 2 then
                    local walkDirection = flatDir.Unit * activePlayerSpeedH
                    vxCent = walkDirection.X
                    vzCent = walkDirection.Z
                end
                
                if math.abs(direction.Y) > 3 then
                    vyCent = (direction.Y > 0 and 1 or -1) * activePlayerSpeedV
                end
                
                if myRoot then
                    pcall(function()
                        myRoot.AssemblyLinearVelocity = Vector3.new(vxCent, vyCent, vzCent)
                        myRoot.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                    end)
                end
            else
                -- Touched targeted coordinate! Flag wait state to pause horizontal drift
                S.isWaitingAtWaypoint = true
                S.waypointReachedTime = currentTick
            end
            continue
        end

        -- Return-to-Car Handler
        if S.isReturningToCar then
            if S.statusLabel then
                S.statusLabel:SetText("Status: Returning to Car...")
            end
            
            -- Detect if we have successfully sat inside the vehicle (checked 60 times/sec)
            if car then
                S.isReturningToCar = false
                S.forceSpawnNext = false 
                S.skipGarageCheck = false -- Reset spawner bypass flag
                S.seatEntryStart = 0
                S.sittingTargetVehicle = nil
                S.ascended = false
                S.aligned = false
                S.targetPlayer = nil
                if S.statusLabel then
                    S.statusLabel:SetText("Status: Flying...")
                end
                
                -- Force immediate vehicle cache reset to acquire your vehicle coordinates instantly
                S.cachedCar = nil
                S.nextCarSearch = 0
                getCarCached()
                continue
            end

            -- Priority A: Check if spawner is ready and trigger dynamic spawn immediately (Bypassed if skipGarageCheck is active)
            local cooldownExpiry = tonumber(S.garageCooldownExpiry) or 0

            if not S.skipGarageCheck and not S.isCheckingGarage and currentTick >= cooldownExpiry then
                task.spawn(function()
                    attemptGarageSpawn()
                end)
                continue -- Temporarily suspend on-foot tracking while spawn menu sequence executes
            end

            -- Priority B: Gliding logic
            if not S.isCheckingGarage then
                local closestCamaro, camaroDist = getClosestCamaro(currentPos)
                if not closestCamaro then
                    if S.statusLabel then
                        S.statusLabel:SetText("Status: Waiting for Camaro (Cooldown)...")
                    end
                    continue
                end

                -- Safe Return-to-Car via 3-Phase Overhead Flight path
                if closestCamaro and myRoot then
                    local seat = closestCamaro:FindFirstChild("Seat") or closestCamaro:FindFirstChildWhichIsA("VehicleSeat")
                    local targetSeatPos = nil
                    if seat then
                        targetSeatPos = seat.Position
                    else
                        local primary = closestCamaro.PrimaryPart or closestCamaro:FindFirstChildWhichIsA("BasePart")
                        targetSeatPos = primary and primary.Position
                    end

                    if targetSeatPos then
                        -- Check XZ horizontal distance using native flat geometry
                        local flatDx = targetSeatPos.X - currentPos.X
                        local flatDz = targetSeatPos.Z - currentPos.Z
                        local horizontalDistance = math.sqrt(flatDx * flatDx + flatDz * flatDz)

                        if not S.returnAscended then
                            -- Phase A: Go straight up to activeHeight
                            if S.statusLabel then
                                S.statusLabel:SetText("Status: Return (Ascending)...")
                            end
                            if currentY < activeHeight then
                                vy = activePlayerSpeedV
                                
                                -- Skydiving/Fall Detection double space click (ONLY on Player Ascension phase)
                                local playerGui = player:FindFirstChildOfClass("PlayerGui") or player:FindFirstChild("PlayerGui")
                                local fallingGui = playerGui and playerGui:FindFirstChild("FallingGui")
                                local buttonObj = fallingGui and fallingGui:FindFirstChild("Button")
                                if buttonObj then
                                    local nowTick = tonumber(tick()) or 0
                                    local lastSpace = tonumber(S.lastSpaceDoubleTap) or 0
                                    if nowTick - lastSpace > 0.5 then
                                        S.lastSpaceDoubleTap = nowTick
                                        task.spawn(function()
                                            tapKey(0x20) -- Press Space
                                            wait(0.05)   -- Lowered internal delay to 0.05s
                                            tapKey(0x20) -- Press Space
                                        end)
                                    end
                                end
                            else
                                S.returnAscended = true
                            end
                        elseif not S.returnAligned then
                            -- Phase B: Glide horizontally keeping height locked to activeHeight
                            if S.statusLabel then
                                S.statusLabel:SetText("Status: Return (Aligning over car)...")
                            end
                            local flatDirection = Vector3.new(targetSeatPos.X - currentPos.X, 0, targetSeatPos.Z - currentPos.Z)
                            local flatDistance = flatDirection.Magnitude

                            -- Tolerant 2D flat XZ alignment radius (8 studs) to prevent stalling
                            if flatDistance > 8 then
                                local velocity = flatDirection.Unit * activePlayerSpeedH
                                vx = velocity.X
                                vy = 0
                                
                                -- Minor vertical correction in alignment to counteract gravity drift
                                local heightDiff = activeHeight - currentY
                                if math.abs(heightDiff) > 5 then
                                    vy = (heightDiff > 0 and 1 or -1) * 35
                                end
                                vz = velocity.Z
                            else
                                S.returnAligned = true
                            end
                        else
                            -- Phase C: Descend straight down onto seat
                            if S.statusLabel then
                                S.statusLabel:SetText("Status: Return (Descending onto car)...")
                            end
                            local direction = targetSeatPos - currentPos
                            local distToSeat = math.sqrt(direction.X * direction.X + direction.Y * direction.Y + direction.Z * direction.Z)

                            -- Generous 8-stud threshold to begin the interaction sequence
                            if distToSeat > 8 then
                                -- Proportional velocity calculations with horizontal/vertical split
                                local velocity = direction * 15
                                local hMag = math.sqrt(velocity.X * velocity.X + velocity.Z * velocity.Z)
                                if hMag > activePlayerSpeedH then
                                    local ratio = activePlayerSpeedH / hMag
                                    velocity = Vector3.new(velocity.X * ratio, velocity.Y, velocity.Z * ratio)
                                end
                                if math.abs(velocity.Y) > activePlayerSpeedV then
                                    velocity = Vector3.new(velocity.X, (velocity.Y > 0 and 1 or -1) * activePlayerSpeedV, velocity.Z)
                                end
                                vx = velocity.X
                                vy = velocity.Y
                                vz = velocity.Z
                            else
                                -- Sit coordinates lock (GENTLE physics float prevents sitting cancel glitches, no hard teleports!)
                                local velocity = direction * 5
                                vx = velocity.X
                                vy = velocity.Y
                                vz = velocity.Z

                                -- Track entry duration on the targeted vehicle seat
                                if S.sittingTargetVehicle ~= closestCamaro then
                                    S.sittingTargetVehicle = closestCamaro
                                    S.seatEntryStart = currentTick
                                end

                                -- If E clicking fails for more than 10.0 seconds, ignore this Camaro and find another
                                local entryStart = tonumber(S.seatEntryStart) or 0
                                if entryStart > 0 and (currentTick - entryStart > 10.0) then
                                    S.blacklistedVehicles[closestCamaro] = currentTick + 45 -- Blacklist car for 45 seconds
                                    notify("Seat Locked or Glitched! Routing to next Camaro...", "CarFly", 3)
                                    
                                    S.seatEntryStart = 0
                                    S.sittingTargetVehicle = nil
                                    S.returnAscended = false
                                    S.returnAligned = false
                                    continue
                                end

                                -- Cooldown E-Tap System: Only taps E once every 1.0 second on seat coordinates
                                local lastETap = tonumber(S.lastETapTime) or 0
                                if currentTick - lastETap > 1.0 then
                                    S.lastETapTime = currentTick
                                    task.spawn(function()
                                        tapKey(0x45)
                                    end)
                                end
                            end
                        end

                        -- Apply proportional velocity vector to player character
                        if (vx ~= 0 or vy ~= 0 or vz ~= 0) then
                            pcall(function()
                                myRoot.AssemblyLinearVelocity = Vector3.new(vx, vy, vz)
                                myRoot.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                            end)
                        end
                    end
                end
            end

            -- Run Return-to-Car Position Stuck check
            local lastPos = tonumber(S.lastPosCheck) or 0
            if currentTick - lastPos > 4.0 then
                S.lastPosCheck = currentTick
                if S.lastCheckedPos then
                    local moved = 999
                    if S.lastCheckedPos and currentPos then
                        pcall(function()
                            local mX = currentPos.X - S.lastCheckedPos.X
                            local mY = currentPos.Y - S.lastCheckedPos.Y
                            local mZ = currentPos.Z - S.lastCheckedPos.Z
                            moved = math.sqrt(mX * mX + mY * mY + mZ * mZ)
                        end)
                    end

                    local applyingVelocity = (vx ~= 0 or vy ~= 0 or vz ~= 0)
                    if applyingVelocity and moved < 5 then
                        local closestCamaro = getClosestCamaro(currentPos)
                        if closestCamaro then
                            S.blacklistedVehicles[closestCamaro] = currentTick + 45
                            notify("Stuck returning to car! Routing to next Camaro...", "CarFly", 3)
                        else
                            notify("Stuck returning! Re-ascending...", "CarFly", 3)
                        end
                        
                        -- Reset states to immediately force re-ascension and clear the building/obstacle
                        S.returnAscended = false
                        S.returnAligned = false
                    end
                end
                S.lastCheckedPos = currentPos
            end

            continue
        end

        -- Verify if the current target is still valid and has not become a prisoner
        local targetValid = false
        local targetPos = getTargetPos(S.targetPlayer)
        local escaped = false
        
        if S.targetPlayer and S.targetPlayer.Parent and S.targetPlayer.Character and targetPos then
            pcall(function()
                -- It must explicitly evaluate as true to remain targeted
                if S.targetPlayer:GetAttribute("HasEscaped") == true then
                    escaped = true
                end
            end)
            if escaped then
                targetValid = true
            end
        end
        
        -- High Speed dropping (ONLY drops active targets if we are NOT currently in the arrest phase)
        if targetValid and S.filterBySpeed and not S.isArresting then
            pcall(function()
                local root = S.targetPlayer.Character:FindFirstChild("HumanoidRootPart") or S.targetPlayer.Character.PrimaryPart
                local vel = root and (root.AssemblyLinearVelocity or root.Velocity)
                if vel then
                    local speed = math.sqrt(vel.X * vel.X + vel.Y * vel.Y + vel.Z * vel.Z)
                    local maxSpeed = tonumber(S.maxTargetSpeedStuds) or 80
                    if speed > maxSpeed then
                        targetValid = false
                        notify("Target moving too fast! Dropping...", "CarFly", 3)
                    end
                end
            end)
        end

        -- Acquire target if needed
        if not targetValid then
            forceReleaseE()
            
            -- Transition Event: If we just finished an arrest and are switching to Return-to-Car
            if S.isArresting then
                local alt = getNearbyAlternativeTarget(currentPos, 120, S.targetPlayer)
                if alt then
                    S.targetPlayer = alt
                    S.isArresting = true -- Stay on foot and chain transition
                    S.aligned = false
                    
                    S.lastDistanceToTarget = 999999999
                    S.lastDistanceCheckTime = currentTick
                    notify("Arrest complete! Chain targeting nearby: " .. alt.Name, "CarFly", 3)
                    if S.targetLabel then
                        S.targetLabel:SetText("Target: " .. alt.Name)
                    end
                else
                    S.isArresting = false
                    S.targetPlayer = nil
                    S.isReturningToCar = true
                    S.returnAscended = false
                    S.returnAligned = false
                    
                    -- Reset distance monitoring locks to ensure a fresh clean state on the next target search
                    S.lastDistanceToTarget = 999999999
                    S.lastDistanceCheckTime = currentTick

                    -- Equip slot 1 cleanly
                    task.spawn(function()
                        wait(0.1) -- Allow key release buffer to clear
                        equipTool(1)
                    end)
                    if S.statusLabel then
                        S.statusLabel:SetText("Status: Target Arrested/Lost! Returning to car...")
                    end
                end
                continue
            end

            local foundPlayer = getNearestPlayer(currentPos)
            if foundPlayer then
                S.targetPlayer = foundPlayer
                S.aligned = false 
                
                -- Initialize target tracking distance monitors to establish fresh benchmarks
                S.lastDistanceToTarget = 999999999
                S.lastDistanceCheckTime = currentTick

                targetPos = getTargetPos(S.targetPlayer)
                if targetPos then
                    notify(string.format("Target: %s | Pos: %s", S.targetPlayer.Name, tostring(targetPos)), "CarFly", 3)
                    if S.targetLabel then
                        S.targetLabel:SetText("Target: " .. S.targetPlayer.Name)
                    end
                else
                    S.targetPlayer = nil
                end
            else
                S.targetPlayer = nil
                if S.targetLabel then
                    S.targetLabel:SetText("Target: Looking for players...")
                end
                if S.statusLabel then
                    S.statusLabel:SetText("Status: Centering Map...")
                end
                
                -- Idle Map Centering Logic (-100, activeHeight, -1400)
                local centerPos = Vector3.new(-100, activeHeight, -1400)
                local dx = centerPos.X - currentPos.X
                local dz = centerPos.Z - currentPos.Z
                local horizontalDistance = math.sqrt(dx * dx + dz * dz)
                
                local vxCent, vyCent, vzCent = 0, 0, 0
                local speedH = car and activeCarSpeed or activePlayerSpeedH
                local speedV = car and activeCarSpeed or activePlayerSpeedV
                
                if currentY < activeHeight then
                    -- Ascend first
                    vyCent = speedV
                else
                    if horizontalDistance > 10 then
                        local flatDir = Vector3.new(dx, 0, dz).Unit
                        vxCent = flatDir.X * speedH
                        vzCent = flatDir.Z * speedH
                        
                        -- Minor height correction while traveling
                        local heightDiff = activeHeight - currentY
                        if math.abs(heightDiff) > 5 then
                            vyCent = (heightDiff > 0 and 1 or -1) * 35
                        end
                    else
                        -- Hover close to target altitude
                        local heightDiff = activeHeight - currentY
                        if math.abs(heightDiff) > 2 then
                            vyCent = (heightDiff > 0 and 1 or -1) * 15
                        end
                    end
                end
                
                if not S.isArresting and not S.isReturningToCar then
                    if car and carPart then
                        pcall(function()
                            carPart.AssemblyLinearVelocity = Vector3.new(vxCent, vyCent, vzCent)
                            carPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                        end)
                    elseif myRoot then
                        pcall(function()
                            myRoot.AssemblyLinearVelocity = Vector3.new(vxCent, vyCent, vzCent)
                            myRoot.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                        end)
                    end
                end
                
                continue
            end
        end

        -- Verify target position again before physics computations
        targetPos = getTargetPos(S.targetPlayer)
        if not targetPos then continue end

        -- Check if target player got too far away during pursuit (Algebraic Magnitude - completely avoids Vector2 constructor issues)
        local tdx = targetPos.X - currentPos.X
        local tdy = targetPos.Y - currentPos.Y
        local tdz = targetPos.Z - currentPos.Z
        local distanceToTarget = math.sqrt(tdx * tdx + tdy * tdy + tdz * tdz)
        
        -- Dynamic local evaluations from the pursuit range slider
        local activeOnFootMax = tonumber(S.onFootMaxRange) or 50
        local activeInCarMax = tonumber(S.inCarMaxRange) or 3500

        -- On-foot escape safety boundary (Target ran away too fast while on foot)
        if S.isArresting and distanceToTarget > activeOnFootMax then
            -- Fetch target speed to see if they are genuinely faster than our horizontal glide speed limits
            local targetSpeed = 0
            pcall(function()
                local targetChar = S.targetPlayer.Character
                local root = targetChar and (targetChar:FindFirstChild("HumanoidRootPart") or targetChar.PrimaryPart)
                local vel = root and (root.AssemblyLinearVelocity or root.Velocity)
                if vel then
                    targetSpeed = math.sqrt(vel.X * vel.X + vel.Y * vel.Y + vel.Z * vel.Z)
                end
            end)

            -- ONLY give up on the chase if their current speed is faster than what our horizontal speed is set to
            if targetSpeed > activePlayerSpeedH then
                forceReleaseE()
                S.isAimingTaser = false
                
                local alt = getNearbyAlternativeTarget(currentPos, 120, S.targetPlayer)
                if alt then
                    S.targetPlayer = alt
                    S.isArresting = true
                    S.aligned = false
                    
                    S.lastDistanceToTarget = 999999999
                    S.lastDistanceCheckTime = currentTick
                    notify("Target outran! Retargeting closer nearby: " .. alt.Name, "CarFly", 3)
                    if S.targetLabel then
                        S.targetLabel:SetText("Target: " .. alt.Name)
                    end
                else
                    S.isArresting = false
                    S.targetPlayer = nil
                    S.isReturningToCar = true
                    S.returnAscended = false
                    S.returnAligned = false
                    
                    task.spawn(function()
                        wait(0.1)
                        equipTool(1)
                    end)
                    if S.statusLabel then
                        S.statusLabel:SetText("Status: Target escaped! Returning to car...")
                    end
                end
                continue
            end
        end

        -- In-car pursuit limit (Target is too far across the map to realistically chase)
        if not S.isArresting and distanceToTarget > activeInCarMax then
            S.targetPlayer = nil
            if S.statusLabel then
                S.statusLabel:SetText("Status: Target too far! Finding closer criminal...")
            end
            continue
        end

        -- Target-Relative Progress Monitor (Unified for both in-car and on-foot phases with dynamic filters & numerical casting locks)
        if S.targetPlayer and distanceToTarget > 6 then
            local checkInterval = 1.0
            local isArrestGraceActive = false
            
            if S.isArresting then
                checkInterval = 3.0 -- Ordered 3.0 second grace timeline out of car
                
                -- Verify 3.0 second grace period upon transitioning to arrest phase
                local phaseStart = tonumber(S.arrestPhaseStart) or 0
                if currentTick - phaseStart < 3.0 then
                    isArrestGraceActive = true
                end
            end
            
            local lastCheck = tonumber(S.lastDistanceCheckTime) or 0
            if not isArrestGraceActive and (currentTick - lastCheck > checkInterval) then
                local priorDist = tonumber(S.lastDistanceToTarget) or 999999999
                
                if priorDist < 999999999 then
                    local deltaDistance = priorDist - distanceToTarget -- positive = getting closer, negative = moving away
                    
                    -- Evaluate minimum progression requirements
                    local minRequiredProgress = S.isArresting and 2.0 or 1.5
                    
                    -- Prevent stuck/outran logic if actively sensing "arrest" or "eject" UI interaction prompts
                    local actionText = getActionText()
                    local activelyInteracting = actionText and (string.find(string.lower(actionText), "arrest") ~= nil or string.find(string.lower(actionText), "eject") ~= nil)
                    
                    if not activelyInteracting and deltaDistance < minRequiredProgress then
                        local targetName = tostring(S.targetPlayer.Name)
                        S.blacklistedPlayers[targetName] = currentTick + 15 -- Blacklist target for exactly 15 seconds
                        notify("Blocked or Outrun! Retargeting " .. targetName, "CarFly", 3)
                        
                        -- Immediately break flight lock and search for a clear criminal
                        forceReleaseE()
                        S.isAimingTaser = false
                        
                        local alt = getNearbyAlternativeTarget(currentPos, 120, S.targetPlayer)
                        if alt then
                            S.targetPlayer = alt
                            S.isArresting = true
                            S.aligned = false
                            S.ascended = false
                            S.lastDistanceToTarget = 999999999
                            S.lastDistanceCheckTime = currentTick
                            if S.targetLabel then
                                S.targetLabel:SetText("Target: " .. alt.Name)
                            end
                        else
                            S.isArresting = false
                            S.targetPlayer = nil
                            S.aligned = false
                            S.ascended = false
                            S.lastDistanceToTarget = 999999999
                            S.lastDistanceCheckTime = currentTick
                            S.isReturningToCar = true
                            S.returnAscended = false
                            S.returnAligned = false
                            
                            task.spawn(function()
                                wait(0.1)
                                equipTool(1)
                            end)
                        end
                        continue
                    end
                end
                
                S.lastDistanceToTarget = distanceToTarget
                S.lastDistanceCheckTime = currentTick
            end
        end

        -- Vertical Ceiling/Roof Stuck Detector (Safe numerical casting applied)
        if S.targetPlayer then
            local flatDx = targetPos.X - currentPos.X
            local flatDz = targetPos.Z - currentPos.Z
            local flatDist = math.sqrt(flatDx * flatDx + flatDz * flatDz)
            local yDiff = math.abs(targetPos.Y - currentPos.Y)
            
            if flatDist < 10 and yDiff > 4 then
                if S.verticalStuckStart == 0 then
                    S.verticalStuckStart = currentTick
                else
                    local stuckStart = tonumber(S.verticalStuckStart) or 0
                    if currentTick - stuckStart > 3.0 then -- Blocked vertically by roof or ceiling for over 3 seconds
                        local targetName = tostring(S.targetPlayer.Name)
                        S.blacklistedPlayers[targetName] = currentTick + 20 -- Blacklist for 20 seconds
                        notify("Roof/Ceiling Blocked! Retargeting " .. targetName, "CarFly", 3)
                        
                        forceReleaseE()
                        S.isAimingTaser = false
                        
                        local alt = getNearbyAlternativeTarget(currentPos, 120, S.targetPlayer)
                        if alt then
                            S.targetPlayer = alt
                            S.isArresting = true
                            S.aligned = false
                            S.ascended = false
                            S.verticalStuckStart = 0
                            if S.targetLabel then
                                S.targetLabel:SetText("Target: " .. alt.Name)
                            end
                        else
                            S.isArresting = false
                            S.targetPlayer = nil
                            S.aligned = false
                            S.ascended = false
                            S.verticalStuckStart = 0
                            S.isReturningToCar = true
                            S.returnAscended = false
                            S.returnAligned = false
                            
                            task.spawn(function()
                                wait(0.1)
                                equipTool(1)
                            end)
                        end
                        continue
                    end
                end
            else
                S.verticalStuckStart = 0
            end
        else
            S.verticalStuckStart = 0
        end

        -- Check if we are close enough to start arresting/teleporting (Handles Tase-then-Cuff Flow natively)
        if distanceToTarget <= 15 or S.isArresting then
            
            -- If this is the transition frame where we just entered the arrest phase
            if not S.isArresting then
                S.isArresting = true
                S.arrestPhaseStart = currentTick -- Capture transition timestamp for the out-of-car grace period
                if S.statusLabel then
                    S.statusLabel:SetText("Status: Initiating Arrest...")
                end

                -- Run the keystroke sequence asynchronously with closures
                task.spawn(function()
                    if not S.holdingE then
                        S.holdingE = true
                        
                        -- 1. Jump out of the car
                        task.spawn(function() tapKey(0x20) end)
                        wait(0.3) -- Settle delay to ensure character is fully out of seat

                        -- Safety boundary
                        if not S.isArresting or not S.enabled then S.holdingE = false return end

                        -- TASER TOGGLE LOGIC
                        if S.useTaser then
                            -- 2. Pull out Taser (Key 3 via hotbar checker)
                            equipTool(3)

                            -- 3. Lock Aimbot onto target player's viewport coordinates
                            S.isAimingTaser = true
                            wait(0.2) -- Camera tracking align duration

                            if not S.isArresting or not S.enabled then S.isAimingTaser = false S.holdingE = false return end

                            -- 4. Shoot Taser (Left Mouse Press) while aiming
                            clickMouse()
                            wait(0.2) -- Let projectile simulation settle

                            -- 5. Stop Aimbot Aiming Camera writes
                            S.isAimingTaser = false
                        end

                        if S.statusLabel then
                            S.statusLabel:SetText("Status: Arresting (Cuffs)...")
                        end
                        
                        -- 6. Equip Cuffs (Slot 2 via hotbar checker)
                        equipTool(2)
                        wait(0.05) -- Brief pause before the hold begins
                        
                        -- Safety boundary
                        if not S.isArresting or not S.enabled then S.holdingE = false return end
                        
                        -- 7. Hold E down continuously in 1-second intervals until target is prisoner
                        while S.isArresting and S.enabled and S.holdingE do
                            local actionText = getActionText()
                            local isArrestOrEject = actionText and (string.find(string.lower(actionText), "arrest") ~= nil or string.find(string.lower(actionText), "eject") ~= nil)
                            
                            if isArrestOrEject then
                                pcall(keypress, 0x45) -- Begin holding E
                                
                                -- Wait up to 1 second but cancel instantly if state, target, or prompt transitions
                                local holdStart = tonumber(tick()) or 0
                                while (tonumber(tick()) or 0) - holdStart < 1.0 do
                                    wait(0.05)
                                    if not S.isArresting or not S.enabled or not S.holdingE then
                                        break
                                    end
                                    
                                    local currentPrompt = getActionText()
                                    local stillArresting = currentPrompt and (string.find(string.lower(currentPrompt), "arrest") ~= nil or string.find(string.lower(currentPrompt), "eject") ~= nil)
                                    if not stillArresting then
                                        break
                                    end
                                end
                                
                                pcall(keyrelease, 0x45) -- Release briefly to cycle
                                wait(0.05)
                            else
                                -- Release E if prompt is missing/inactive and wait
                                pcall(keyrelease, 0x45)
                                wait(0.05)
                            end
                        end
                    end
                end)
            end

            -- Smooth proportional physics velocity flight to target player
            if myRoot then
                -- Target offset elevated 5 studs above criminal to prevent floor dragging
                local adjustedTargetPos = targetPos + Vector3.new(0, 5, 0)
                local direction = adjustedTargetPos - currentPos
                local dist = math.sqrt(direction.X * direction.X + direction.Y * direction.Y + direction.Z * direction.Z)

                if dist > 1.5 then
                    local velocity = direction * 15
                    
                    -- Separate Horizontal and Vertical speed limits for proportional on-foot glide
                    local hMag = math.sqrt(velocity.X * velocity.X + velocity.Z * velocity.Z)
                    if hMag > activePlayerSpeedH then
                        local ratio = activePlayerSpeedH / hMag
                        velocity = Vector3.new(velocity.X * ratio, velocity.Y, velocity.Z * ratio)
                    end
                    if math.abs(velocity.Y) > activePlayerSpeedV then
                        velocity = Vector3.new(velocity.X, (velocity.Y > 0 and 1 or -1) * activePlayerSpeedV, velocity.Z)
                    end
                    
                    vx = velocity.X
                    vy = velocity.Y
                    vz = velocity.Z
                else
                    -- Hover directly on top of their head when reached (stabilization locks)
                    local velocity = direction * 5
                    vx = velocity.X
                    vy = velocity.Y
                    vz = velocity.Z
                end

                pcall(function()
                    myRoot.AssemblyLinearVelocity = Vector3.new(vx, vy, vz)
                    myRoot.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                end)
            end
        else
            -- Normal Flight Handling (Moving the car)
            if not S.ascended then
                -- Phase 1: Go straight up to activeHeight
                if S.statusLabel then
                    S.statusLabel:SetText("Status: Ascending...")
                end
                if currentY < activeHeight then
                    vy = activeCarSpeed
                else
                    S.ascended = true
                end
            else
                local horizontalDistance = 0
                if targetPos and currentPos then
                    -- 2D Math implementation for alignment (avoids Vector2 mismatch crashes)
                    local tdx = targetPos.X - currentPos.X
                    local tdz = targetPos.Z - currentPos.Z
                    horizontalDistance = math.sqrt(tdx * tdx + tdz * tdz)
                end
                horizontalDistance = tonumber(horizontalDistance) or 0

                if not S.aligned then
                    -- Phase 2: Horizontal flight keeping altitude locked to activeHeight
                    if S.statusLabel then
                        S.statusLabel:SetText("Status: Aligning over target...")
                    end
                    local flatDirection = Vector3.new(targetPos.X - currentPos.X, 0, targetPos.Z - currentPos.Z)
                    local flatDistance = flatDirection.Magnitude

                    -- Highly responsive 2D flat alignment boundary (8 studs)
                    if flatDistance > 8 then
                        local velocity = flatDirection.Unit * activeCarSpeed
                        vx = velocity.X
                        vy = 0
                        
                        -- Maintain vertical height during flight over targets
                        local heightDiff = activeHeight - currentY
                        if math.abs(heightDiff) > 5 then
                            vy = (heightDiff > 0 and 1 or -1) * 35
                        end
                        vz = velocity.Z
                    else
                        S.aligned = true
                    end
                else
                    -- Phase 3: Descend straight down to the player's ground level
                    if S.statusLabel then
                        S.statusLabel:SetText("Status: Descending straight down...")
                    end
                    
                    local horizDirection = Vector3.new(targetPos.X - currentPos.X, 0, targetPos.Z - currentPos.Z)
                    local vertDirection = Vector3.new(0, targetPos.Y - currentPos.Y, 0)
                    
                    local horizMag = horizDirection and tonumber(horizDirection.Magnitude) or 0
                    local vertMag = vertDirection and tonumber(vertDirection.Magnitude) or 0

                    local horizVel = horizMag > 2 and (horizDirection.Unit * activeCarSpeed) or Vector3.new(0, 0, 0)
                    local vertVel = vertMag > 5 and (vertDirection.Unit * (activeCarSpeed * 0.6)) or Vector3.new(0, 0, 0)
                    
                    local velocity = horizVel + vertVel
                    vx = velocity.X
                    vy = velocity.Y
                    vz = velocity.Z

                    -- If target moves more than 40 studs away, pull up and realign
                    if horizontalDistance > 40 then
                        S.aligned = false
                    end
                end
            end

            -- Run Position Stuck check (Triggered if vehicle stays stuck in place for 4.0 seconds - defensively cast)
            local lastPos = tonumber(S.lastPosCheck) or 0
            if currentTick - lastPos > 4.0 then -- Configured 4-second stuck window
                S.lastPosCheck = currentTick
                if S.lastCheckedPos then
                    -- Native mathematical magnitude (eliminates Magnitude property crash)
                    local moved = 999
                    if S.lastCheckedPos and currentPos then
                        pcall(function()
                            local mX = currentPos.X - S.lastCheckedPos.X
                            local mY = currentPos.Y - S.lastCheckedPos.Y
                            local mZ = currentPos.Z - S.lastCheckedPos.Z
                            moved = math.sqrt(mX * mX + mY * mY + mZ * mZ)
                        end)
                    end

                    local applyingVelocity = (vx ~= 0 or vy ~= 0 or vz ~= 0)
                    
                    if applyingVelocity and moved < 5 then
                        if S.targetPlayer then
                            local targetName = tostring(S.targetPlayer.Name)
                            S.blacklistedPlayers[targetName] = currentTick + 20 -- Blacklist for 20 seconds
                            notify("Stuck! Blacklisting " .. targetName, "CarFly", 3)
                        end
                        
                        -- Reset states to immediately break lock and ascend
                        S.targetPlayer = nil
                        S.aligned = false
                        S.ascended = false
                    end
                end
                S.lastCheckedPos = currentPos
            end

            -- Apply velocity to the root assembly part only if we are sitting in the car (prevents ghost flight)
            if not S.isArresting and not S.isReturningToCar and carPart then
                pcall(function()
                    carPart.AssemblyLinearVelocity  = Vector3.new(vx, vy, vz)
                    carPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                end)
            end
        end
    end 
end)

notify("Press P to toggle menu, G to toggle flight", "CarFly Loaded", 4)
