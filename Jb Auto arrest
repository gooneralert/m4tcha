-- Dynamic Targeting Alternative Scanner to chain arrests within given bounds on foot
function getNearbyAlternativeTarget(currentPos, maxRadius, ignoreTarget)
    maxRadius = maxRadius or 120
    if not currentPos then return nil end
    local targetablePlayers = {}
    local now = tonumber(tick()) or 0
    
    local localName = tostring(player.Name)
    local localTeamName = ""
    pcall(function()
        if player.Team then
            localTeamName = tostring(player.Team.Name)
        end
    end)

    local activePlayerSpeedH = tonumber(S.playerSpeedHorizontal) or 110

    for _, p in ipairs(Players:GetPlayers()) do
        if ignoreTarget and p == ignoreTarget then continue end
        
        local targetable = true
        
        if S.blacklistedPlayers[p.Name] and now < S.blacklistedPlayers[p.Name] then
            targetable = false
        end

        pcall(function()
            if p.Team and tostring(p.Team.Name) == localTeamName then
                targetable = false
            end
            if p:GetAttribute("HasEscaped") ~= true then
                targetable = false
            end
        end)

        if p.Name ~= localName and targetable and p.Character then
            local root = p.Character:FindFirstChild("HumanoidRootPart")
            if root and root.Position then
                local targetY = tonumber(root.Position.Y) or 0
                local isUnderground = targetY < 13

                if not isUnderground then
                    local dx = root.Position.X - currentPos.X
                    local dy = root.Position.Y - currentPos.Y
                    local dz = root.Position.Z - currentPos.Z
                    local dist = math.sqrt(dx * dx + dy * dy + dz * dz)

                    -- Filter by passed range boundary
                    if dist <= maxRadius then
                        -- Fetch target velocity to compare with player on-foot flight limits
                        local speed = 0
                        local vel = root.AssemblyLinearVelocity or root.Velocity
                        if vel then
                            speed = math.sqrt(vel.X * vel.X + vel.Y * vel.Y + vel.Z * vel.Z)
                        end
                        
                        -- Target speed limit constraint
                        if speed < activePlayerSpeedH then
                            local rawName = p.Name or ""
                            local rawDisplay = p.DisplayName or ""
                            
                            local lowerName = string.lower(rawName)
                            local lowerDisplay = string.lower(rawDisplay)
                            
                            local pBounty = tonumber(S.scrapedBounties[lowerName]) or tonumber(S.scrapedBounties[lowerDisplay]) or 0
                            
                            table.insert(targetablePlayers, {
                                player = p,
                                dist = dist,
                                bounty = pBounty
                            })
                        end
                    end
                end
            end
        end
    end

    if #targetablePlayers > 0 then
        if S.prioritizeBounty then
            table.sort(targetablePlayers, function(a, b)
                if a.bounty ~= b.bounty then
                    return a.bounty > b.bounty
                end
                return a.dist < b.dist
            end)
        else
            table.sort(targetablePlayers, function(a, b)
                return a.dist < b.dist
            end)
        end
        return targetablePlayers[1].player
    end

    return nil
end

-- String parser to translate game timers (e.g. "0:45", "15S", "10") to seconds
function parseCooldownSeconds(text)
    text = tostring(text):upper()
    -- Pattern A: "MM:SS" (e.g., "1:15" or "0:45")
    local min, sec = text:match("(%d+):(%d+)")
    if min and sec then
        return (tonumber(min) * 60) + tonumber(sec)
    end
    -- Pattern B: Raw numeric countdowns (e.g. "45S" or "10 SECONDS")
    local digits = text:match("(%d+)")
    if digits then
        return tonumber(digits)
    end
    return 0
end

