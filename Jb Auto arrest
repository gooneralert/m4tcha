-- Defensively structured to prevent nil indexing if vehicles delete or stream out mid-execution
function scanForCar()
    local pname = player.Name
    local vehiclesFolder = Workspace:FindFirstChild("Vehicles")
    if not vehiclesFolder then return nil end
    
    for _, v in ipairs(vehiclesFolder:GetChildren()) do
        if v:FindFirstChild("_VehicleState_" .. pname) then 
            return v 
        end
        
        local seat = v:FindFirstChild("Seat")
        if seat then
            local playerNameVal = seat:FindFirstChild("PlayerName")
            if playerNameVal and playerNameVal.Value == pname then 
                return v 
            end
        end
    end
    return nil
end

function getCarCached()
    local now = tonumber(tick()) or 0
    local searchTime = tonumber(S.nextCarSearch) or 0
    
    -- Bypass caching cooldowns if we are currently searching for our car to enter
    if S.isReturningToCar then
        local car = scanForCar()
        if car then
            S.cachedCar = car
            S.cachedRoot = car.PrimaryPart or car:FindFirstChild("Collision") or car:FindFirstChild("Body") or car:FindFirstChildWhichIsA("BasePart")
        else
            S.cachedCar = nil
            S.cachedRoot = nil
        end
        return S.cachedCar, S.cachedRoot
    end
    
    -- Standard caching logic during normal flight
    if not S.cachedCar or now >= searchTime then
        local car = scanForCar()
        if car then
            S.cachedCar = car
            S.cachedRoot = car.PrimaryPart or car:FindFirstChild("Collision") or car:FindFirstChild("Body") or car:FindFirstChildWhichIsA("BasePart")
            S.nextCarSearch = now + 2.0
        else
            S.cachedCar = nil
            S.cachedRoot = nil
            S.nextCarSearch = now + 0.3
        end
    end
    return S.cachedCar, S.cachedRoot
end

function getNearestPlayer(currentPos)
    local targetablePlayers = {}
    local now = tonumber(tick()) or 0
    
    local localName = tostring(player.Name)
    local localTeamName = ""
    pcall(function()
        if player.Team then
            localTeamName = tostring(player.Team.Name)
        end
    end)

    local activeInCarMax = tonumber(S.inCarMaxRange) or 3500

    for _, p in ipairs(Players:GetPlayers()) do
        local targetable = true
        
        -- Filter out blacklisted players
        if S.blacklistedPlayers[p.Name] and now < S.blacklistedPlayers[p.Name] then
            targetable = false
        end

        pcall(function()
            -- Ignore teammates
            if p.Team and tostring(p.Team.Name) == localTeamName then
                targetable = false
            end
            -- Attribute Check: Only targets players whose HasEscaped is true
            if p:GetAttribute("HasEscaped") ~= true then
                targetable = false
            end
            
            -- Dynamic Speed Limit Safety Filter (Prevents selecting targets that exceed active limits)
            if S.filterBySpeed and targetable and p.Character then
                local root = p.Character:FindFirstChild("HumanoidRootPart") or p.Character.PrimaryPart
                local vel = root and (root.AssemblyLinearVelocity or root.Velocity)
                if vel then
                    local speed = math.sqrt(vel.X * vel.X + vel.Y * vel.Y + vel.Z * vel.Z)
                    local maxSpeed = tonumber(S.maxTargetSpeedStuds) or 80
                    if speed > maxSpeed then
                        targetable = false
                    end
                end
            end
        end)

        if p.Name ~= localName and targetable and p.Character then
            local root = p.Character:FindFirstChild("HumanoidRootPart")
            if root and root.Position and currentPos then
                -- Filter out players in sewers/underground (typically Y < 13 studs)
                local targetY = tonumber(root.Position.Y) or 0
                local isUnderground = targetY < 13

                if not isUnderground then
                    -- Native 3D algebraic geometry distance
                    local dx = root.Position.X - currentPos.X
                    local dy = root.Position.Y - currentPos.Y
                    local dz = root.Position.Z - currentPos.Z
                    local dist = math.sqrt(dx * dx + dy * dy + dz * dz)

                    -- Pre-filter by pursuit limit range
                    if dist <= activeInCarMax then
                        -- Safe Double Lowercase mapping (Username and DisplayName) to prevent Matcha nil lower-indexing crashes
                        local rawName = p.Name or ""
                        local rawDisplay = p.DisplayName or ""
                        
                        local lowerName = string.lower(rawName)
                        local lowerDisplay = string.lower(rawDisplay)
                        
                        local pBounty = tonumber(S.scrapedBounties[lowerName]) or tonumber(S.scrapedBounties[lowerDisplay]) or 0
                        
                        table.insert(targetablePlayers, {
                            player = p,
                            dist = dist,
                            bounty = pBounty
                        })
                    end
                end
            end
        end
    end

    -- Return targeted choices based on sorting configurations
    if #targetablePlayers > 0 then
        if S.prioritizeBounty then
            table.sort(targetablePlayers, function(a, b)
                if a.bounty ~= b.bounty then
                    return a.bounty > b.bounty -- Highest bounty takes global priority
                end
                return a.dist < b.dist -- Fall back to proximity on tied bounty values
            end)
            local selected = targetablePlayers[1]
            print(string.format("[CarFly Debug] Target selected by BOUNTY: %s (Bounty: $%d, Dist: %d studs)", selected.player.Name, selected.bounty, math.floor(selected.dist)))
            return selected.player
        else
            table.sort(targetablePlayers, function(a, b)
                return a.dist < b.dist -- Standard proximity priority
            end)
            local selected = targetablePlayers[1]
            print(string.format("[CarFly Debug] Target selected by DISTANCE: %s (Bounty: $%d, Dist: %d studs)", selected.player.Name, selected.bounty, math.floor(selected.dist)))
            return selected.player
        end
    end

    return nil
end

function getClosestCamaro(currentPos)
    local vehiclesFolder = Workspace:FindFirstChild("Vehicles")
    if not vehiclesFolder then return nil, 999999999 end

    local nearest = nil
    local minDist = 999999999
    local now = tonumber(tick()) or 0

    local function checkVehicle(v)
        -- Ignore vehicles flagged as glitched/unenterable
        if S.blacklistedVehicles[v] and now < S.blacklistedVehicles[v] then
            return
        end

        local root = v.PrimaryPart or v:FindFirstChild("Collision") or v:FindFirstChild("Body") or v:FindFirstChildWhichIsA("BasePart")
        if root and root.Position then
            -- Native algebraic distance
            local dx = root.Position.X - currentPos.X
            local dy = root.Position.Y - currentPos.Y
            local dz = root.Position.Z - currentPos.Z
            local dist = math.sqrt(dx * dx + dy * dy + dz * dz)

            if dist < minDist then
                minDist = dist
                nearest = v
            end
        end
    end

    -- Path A: Camaro Folder inside Vehicles
    local camaroFolder = vehiclesFolder:FindFirstChild("Camaro")
    if camaroFolder then
        for _, v in ipairs(camaroFolder:GetChildren()) do
            checkVehicle(v)
        end
    end

    -- Path B: Individual Camaros directly inside Vehicles folder
    for _, v in ipairs(vehiclesFolder:GetChildren()) do
        if v.Name == "Camaro" then
            checkVehicle(v)
        end
    end

    return nearest, minDist
end

-- Click UI Object safely using Matcha viewport coordinates + micro-movement offset
function clickGui(gui)
    if gui and gui:IsA("GuiObject") then
        local pos = gui.AbsolutePosition
        local size = gui.AbsoluteSize
        if pos and size then
            local cx = math.floor(pos.X + (size.X / 2))
            local cy = math.floor(pos.Y + (size.Y / 2))
            
            -- Warp to element center
            mousemoveabs(cx, cy)
            wait(0.05)
            
            -- Shift cursor by 3px horizontally/vertically to force VM mouseover replication
            mousemoveabs(cx + 3, cy + 3)
            wait(0.05)
            
            -- Click element
            clickMouse()
        end
    end
end

-- Execute Camaro Spawning Sequence with dynamic polling and human-like hover delays
function attemptGarageSpawn()
    local playerGui = player:FindFirstChildOfClass("PlayerGui") or player:FindFirstChild("PlayerGui")
    if not playerGui then 
        print("[CarFly Debug] Error: PlayerGui folder could not be located under LocalPlayer!")
        return 
    end

    local garageBtn = getPath(playerGui, "AppUI", "Buttons", "Sidebar", "Garage", "Garage")
    if not garageBtn then
        print("[CarFly Debug] Error: Sidebar Garage button path is missing from AppUI!")
        return
    end

    S.isCheckingGarage = true
    if S.statusLabel then
        S.statusLabel:SetText("Status: Opening Garage Panel...")
    end
    clickGui(garageBtn) -- Open Garage

    -- Poll until we read an active status (up to 2.0 seconds timeout)
    local checkStart = tonumber(tick()) or 0
    local textVal = ""

    while (tonumber(tick()) or 0) - checkStart < 2.0 do
        local cooldownTitle = getPath(playerGui, "AppUI", "Garage", "Left", "Categories", "Cooldown", "Title")
        local rawText = cooldownTitle and cooldownTitle.Text and tostring(cooldownTitle.Text) or ""
        
        -- Safe string trimming
        rawText = rawText:match("^%s*(.-)%s*$") or ""
        
        if rawText ~= "" then
            textVal = rawText:upper()
            break
        end
        wait(0.05) -- Brief delay between checks to prevent lag
    end

    print("[CarFly Debug] Cooldown text value validated: '" .. textVal .. "'")

    if textVal == "READY" then
        local spawnBtn = getPath(playerGui, "AppUI", "Garage", "Center", "Portal", "Body", "ScrollingGrid", "Camaro")
        if spawnBtn then
            if S.statusLabel then
                S.statusLabel:SetText("Status: Spawning Camaro...")
            end
            
            -- Micro-Movement Hover Sequence: Warp center -> slide offset -> wait 0.5s -> click
            local pos = spawnBtn.AbsolutePosition
            local size = spawnBtn.AbsoluteSize
            if pos and size then
                local cx = math.floor(pos.X + (size.X / 2))
                local cy = math.floor(pos.Y + (size.Y / 2))
                
                mousemoveabs(cx, cy) -- Warp to Camaro center
                wait(0.1)
                
                mousemoveabs(cx + 3, cy + 3) -- Micro-slide to force hover register
                wait(0.4) -- Complete remaining 0.5s pause
                
                clickMouse() -- Click spawned grid item
            end
            wait(0.2)
            
            -- Reset memory lockout since spawn was successful
            S.garageCooldownExpiry = 0
            
            -- Seating E-press (Explicit thread closures required by Matcha)
            task.spawn(function()
                tapKey(0x45)
            end)
        end
    else
        -- Not READY: Close menu & Parse how long is left to store standard lockout timestamp
        local parsedSeconds = parseCooldownSeconds(textVal)
        local currentTime = tonumber(tick()) or 0
        if parsedSeconds and parsedSeconds > 0 then
            S.garageCooldownExpiry = currentTime + parsedSeconds
            print(string.format("[CarFly Debug] Storing Garage lock for %s seconds.", tostring(parsedSeconds)))
        else
            -- Backup short Lockout block
            S.garageCooldownExpiry = currentTime + 10
        end

        if S.statusLabel then
            S.statusLabel:SetText("Status: Spawner locked. Closing...")
        end
        clickGui(garageBtn)
        wait(0.15)
    end

    S.isCheckingGarage = false
end

function forceReleaseE()
