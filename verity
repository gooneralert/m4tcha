    for i = 1, #particlePool do
        particlePool[i].Dot.Visible = false
    end
end

local function InitObstacles(char)
    local list = {}
    local ws = game:GetService("Workspace")
    local ok, children = pcall(function() return ws:GetChildren() end)
    if not ok or not children then return end

    for i = 1, #children do
        local child = children[i]
        if child ~= char and child.Name ~= "Players" and child.Name ~= "Camera" then
            if child:IsA("BasePart") and child.CanCollide then
                table.insert(list, child)
            elseif child:IsA("Model") or child:IsA("Folder") then
                local sub = child:GetChildren()
                for j = 1, math.min(#sub, 80) do
                    local sc = sub[j]
                    if sc:IsA("BasePart") and sc.CanCollide and not (char and sc:IsDescendantOf(char)) then
                        table.insert(list, sc)
                    end
                end
            end
        end
    end
    allCollidable = list
end

local function UpdateNearbyObstacles(trackPos)
    if not trackPos or typeof(trackPos) ~= "Vector3" then return end
    local nearby = {}
    local count = 0
    for i = 1, #allCollidable do
        local p = allCollidable[i]
        if p and p.Parent then
            local pPos = p.Position
            local pSize = p.Size
            local diff = pPos - trackPos
            local maxExt = pSize.Magnitude / 2
            if diff.Magnitude < (40.0 + maxExt) then
                count = count + 1
                nearby[count] = p
                if count >= 50 then break end
            end
        end
    end
    nearbyObstacles = nearby
end

local function RayBox(ox, oz, dx, dz, maxD, minX, maxX, minZ, maxZ)
    local tmin = 0
    local tmax = maxD

    if math.abs(dx) > 0.0001 then
        local tx1 = (minX - ox) / dx
        local tx2 = (maxX - ox) / dx
        if tx1 > tx2 then tx1, tx2 = tx2, tx1 end
        if tx1 > tmin then tmin = tx1 end
        if tx2 < tmax then tmax = tx2 end
        if tmin > tmax then return false, maxD end
    else
        if ox < minX or ox > maxX then return false, maxD end
    end

    if math.abs(dz) > 0.0001 then
        local tz1 = (minZ - oz) / dz
        local tz2 = (maxZ - oz) / dz
        if tz1 > tz2 then tz1, tz2 = tz2, tz1 end
        if tz1 > tmin then tmin = tz1 end
        if tz2 < tmax then tmax = tz2 end
        if tmin > tmax then return false, maxD end
    else
        if oz < minZ or oz > maxZ then return false, maxD end
    end

    if tmin >= 0 and tmin <= maxD then
        return true, tmin
    end
    return false, maxD
end

local function CastRay(origin, dir, maxDist)
    local closest = maxDist
    local hit = false

    for i = 1, #nearbyObstacles do
        local p = nearbyObstacles[i]
        if p and p.Parent then
            local pPos = p.Position
            local pSize = p.Size
            local pMinY = pPos.Y - (pSize.Y / 2)
            local pMaxY = pPos.Y + (pSize.Y / 2)

            if (origin.Y + 2.0) >= pMinY and (origin.Y - 2.0) <= pMaxY then
                local hX = pSize.X / 2
                local hZ = pSize.Z / 2
                local didHit, dist = RayBox(origin.X, origin.Z, dir.X, dir.Z, maxDist, pPos.X - hX, pPos.X + hX, pPos.Z - hZ, pPos.Z + hZ)
                if didHit and dist < closest and dist > 0.05 then
                    closest = dist
                    hit = true
                end
            end
        end
    end
    return hit, closest
end

local function GetGroundY(pos)
    local highest = -99999
    local found = false

    for i = 1, #nearbyObstacles do
        local p = nearbyObstacles[i]
        if p and p.Parent then
            local pPos = p.Position
            local pSize = p.Size
            local minX = pPos.X - (pSize.X / 2) - 0.5
            local maxX = pPos.X + (pSize.X / 2) + 0.5
            local minZ = pPos.Z - (pSize.Z / 2) - 0.5
            local maxZ = pPos.Z + (pSize.Z / 2) + 0.5
            local topY = pPos.Y + (pSize.Y / 2)

            if pos.X >= minX and pos.X <= maxX and pos.Z >= minZ and pos.Z <= maxZ then
                if topY <= (pos.Y + 3.0) and topY >= (pos.Y - 15.0) then
                    if topY > highest then
                        highest = topY
                        found = true
                    end
                end
            end
        end
    end
    return found and highest or nil
end

local function ResolveWalls(pos, radius, height)
    local feetY = pos.Y - (height / 2)
    local headY = pos.Y + (height / 2)

    for i = 1, #nearbyObstacles do
        local p = nearbyObstacles[i]
        if p and p.Parent then
            local pPos = p.Position
            local pSize = p.Size
            local pMinY = pPos.Y - (pSize.Y / 2)
            local pMaxY = pPos.Y + (pSize.Y / 2)

            if (pMaxY > feetY + 1.0) and (pMinY < headY - 1.0) then
                local hX = pSize.X / 2
                local hZ = pSize.Z / 2
                local minX = pPos.X - hX
                local maxX = pPos.X + hX
                local minZ = pPos.Z - hZ
                local maxZ = pPos.Z + hZ

                local cx = math.max(minX, math.min(pos.X, maxX))
                local cz = math.max(minZ, math.min(pos.Z, maxZ))

                local dx = pos.X - cx
                local dz = pos.Z - cz
                local distSq = dx * dx + dz * dz

                if distSq < (radius * radius) then
                    local dist = math.sqrt(distSq)
                    if dist > 0.001 then
                        local push = radius - dist
                        pos = Vector3.new(pos.X + (dx / dist) * push, pos.Y, pos.Z + (dz / dist) * push)
                    end
                end
            end
        end
    end
    return pos
end

local function Draw3DBillboardImage(worldPos, worldSize, camPos, nameText)
    local toCam = camPos - worldPos
    local dist = toCam.Magnitude
    if dist < 0.2 then return end

    local cam = game:GetService("Workspace").CurrentCamera
    local vSize = (cam and cam.ViewportSize and cam.ViewportSize.X > 200) and cam.ViewportSize or Vector2.new(1920, 1080)
    local fov = (cam and cam.FieldOfView and cam.FieldOfView > 10) and cam.FieldOfView or 70
    local focalLength = (vSize.Y * 0.5) / math.tan(math.rad(fov * 0.5))

    local sCenter, onScreen = WorldToScreen(worldPos)
    local pixelSize = (worldSize / math.max(0.1, dist)) * focalLength
    local halfSize = pixelSize * 0.5

    if onScreen then
        local posX = sCenter.X - halfSize
        local posY = sCenter.Y - halfSize

        botImage.Position = Vector2.new(posX, posY)
        botImage.Size = Vector2.new(pixelSize, pixelSize)
        botImage.Visible = true

        if nameText then
            botName.Position = Vector2.new(sCenter.X, posY - 20)
            botName.Visible = true
        else
            botName.Visible = false
        end
    else
        HideBot()
    end
end

local function TriggerJumpscareAndKill()
    jumpscareActive = true
    jumpscareEndTime = tick() + 2.0
    botActive = false
    animStage = "idle"
    HideBot()
    HideHeadDrawings()
    HideAnimationDrawings()

    local info = GetPlayerInfo()
    local char = info and info.Character or (game:GetService("Players").LocalPlayer and game:GetService("Players").LocalPlayer.Character)
    if char then
        pcall(function()
            if typeof(memory_write) == "function" and HealthOffset and char:FindFirstChild("Humanoid") then
                local hum = char:FindFirstChild("Humanoid")
                if hum.Address then
                    memory_write("int", hum.Address + HealthOffset, 0)
                end
            end
        end)
        pcall(function()
            if char:FindFirstChild("Humanoid") then
                char.Humanoid.Health = 0
            end
        end)
    end
end

