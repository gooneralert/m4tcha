local function UpdateBot(dt, camPos, targetPos)
    if not targetPos or not botPos or typeof(targetPos) ~= "Vector3" or typeof(botPos) ~= "Vector3" then return end

    local toTarget = targetPos - botPos
    local flatTarget = Vector3.new(toTarget.X, 0, toTarget.Z)
    local distToTarget = flatTarget.Magnitude
    local totalDist = toTarget.Magnitude

    if totalDist <= 3.5 or distToTarget <= 2.2 then
        TriggerJumpscareAndKill()
        return
    end

    local torsoOrigin = Vector3.new(botPos.X, botPos.Y - (BotSettings.Size / 2) + 3.0, botPos.Z)
    local desiredDir = (distToTarget > 0.001) and flatTarget.Unit or Vector3.new(0, 0, 1)
    local perpRight = Vector3.new(desiredDir.Z, 0, -desiredDir.X)

    rayTimer = rayTimer + dt
    local interval = 1 / math.max(1, BotSettings.RaysPerSec)

    if rayTimer >= interval then
        rayTimer = rayTimer % interval

        for i = 1, BotSettings.NumRays do
            local angle = ((i - 1) / BotSettings.NumRays) * (math.pi * 2)
            local dir = Vector3.new(math.cos(angle), 0, math.sin(angle)).Unit
            local hit, dist = CastRay(torsoOrigin, dir, BotSettings.MaxRayDist)
            rayDirs[i] = dir
            rayHits[i] = hit
            rayDists[i] = dist
        end

        local isDirectClear = true
        for i = 1, BotSettings.NumRays do
            if rayDirs[i] and rayDirs[i]:Dot(desiredDir) > 0.55 then
                if rayHits[i] then
                    isDirectClear = false
                    break
                end
            end
        end

        if isDirectClear then
            isWallFollowing = false
            traversalSide = 0
            chosenDir = desiredDir
        else
            if not isWallFollowing or traversalSide == 0 then
                isWallFollowing = true
                local leftScore = -999
                local rightScore = -999

                for i = 1, BotSettings.NumRays do
                    if rayDirs[i] and not rayHits[i] then
                        local sideFactor = rayDirs[i]:Dot(perpRight)
                        local align = rayDirs[i]:Dot(desiredDir)
                        if sideFactor < 0 and align > leftScore then
                            leftScore = align
                        elseif sideFactor > 0 and align > rightScore then
                            rightScore = align
                        end
                    end
                end
                traversalSide = (leftScore >= rightScore) and 1 or -1
            end

            local bestScore = -999
            local bestClearRay = nil

            for i = 1, BotSettings.NumRays do
                if rayDirs[i] and not rayHits[i] then
                    local sideFactor = rayDirs[i]:Dot(perpRight)
                    local sideSign = (sideFactor >= 0) and -1 or 1
                    if sideSign == traversalSide then
                        local score = rayDirs[i]:Dot(desiredDir)
                        if score > bestScore then
                            bestScore = score
                            bestClearRay = rayDirs[i]
                        end
                    end
                end
            end

            if not bestClearRay then
                local maxD = -1
                for i = 1, BotSettings.NumRays do
                    if rayDirs[i] then
                        local sideFactor = rayDirs[i]:Dot(perpRight)
                        local sideSign = (sideFactor >= 0) and -1 or 1
                        if sideSign == traversalSide and (rayDists[i] or 0) > maxD then
                            maxD = rayDists[i]
                            bestClearRay = rayDirs[i]
                        end
                    end
                end
            end

            chosenDir = bestClearRay or desiredDir or Vector3.new(0, 0, 1)
        end
    end

    smoothDir = (smoothDir and typeof(smoothDir) == "Vector3") and smoothDir or Vector3.new(0, 0, 1)
    chosenDir = (chosenDir and typeof(chosenDir) == "Vector3") and chosenDir or Vector3.new(0, 0, 1)

    local stepAlpha = math.min(1, dt * 10.0)
    local diff = chosenDir - smoothDir
    local lerped = smoothDir + (diff * stepAlpha)
    smoothDir = (lerped.Magnitude > 0.001) and lerped.Unit or chosenDir

    local newPos = botPos + (smoothDir * (BotSettings.Speed * dt))
    newPos = ResolveWalls(newPos, BotSettings.CollisionRadius, BotSettings.Size)

    local groundY = GetGroundY(newPos)
    local halfH = BotSettings.Size / 2
    if groundY then
        local targetCenterY = groundY + halfH
        newPos = Vector3.new(newPos.X, newPos.Y + (targetCenterY - newPos.Y) * math.min(1, dt * 12), newPos.Z)
    else
        newPos = Vector3.new(newPos.X, newPos.Y + (targetPos.Y - newPos.Y) * math.min(1, dt * 4), newPos.Z)
    end

    botPos = newPos

    Draw3DBillboardImage(botPos, BotSettings.Size, camPos, true)
end

local function UpdateSpawnAnimation(dt, camPos)
    local radius = Settings.Radius

    if animStage == "jumping" then
        ballVel = ballVel - Vector3.new(0, 32.0 * dt, 0)
        local nextPos = ballPos + ballVel * dt
        nextPos = ResolveWalls(nextPos, radius, radius * 2)

        local groundY = GetGroundY(nextPos) or floorFallbackY
        if groundY and (nextPos.Y - radius) <= groundY then
            nextPos = Vector3.new(nextPos.X, groundY + radius, nextPos.Z)
            if math.abs(ballVel.Y) > 4.0 then
                ballVel = Vector3.new(ballVel.X * 0.45, -ballVel.Y * 0.35, ballVel.Z * 0.45)
            else
                ballVel = Vector3.new(0, 0, 0)
                animStage = "cracking"
                crackStartTime = tick()
            end
        end

        ballPos = nextPos
        ballPitch = ballPitch + dt * 10.0

        local ballCF = CFrame.new(ballPos.X, ballPos.Y, ballPos.Z) * CFrame.fromOrientation(0, ballYaw, 0) * CFrame.Angles(ballPitch, 0, 0)
        RenderHead(ballCF, camPos)

    elseif animStage == "cracking" then
        local elapsed = tick() - crackStartTime
        local progress = math.min(1, elapsed / 3.0)

        local shakeStrength = progress * 0.35
        local shake = Vector3.new(math.sin(elapsed * 60.0) * shakeStrength, math.cos(elapsed * 55.0) * (shakeStrength * 0.5), math.cos(elapsed * 65.0) * shakeStrength)
        local currentPos = ballPos + shake

        local ballCF = CFrame.new(currentPos.X, currentPos.Y, currentPos.Z) * CFrame.fromOrientation(0, ballYaw, 0)
        RenderHead(ballCF, camPos)

        local fullRun = "Run..."
        local letters = math.max(0, math.min(#fullRun, math.floor(progress * (#fullRun + 1))))
        crackText.Text = string.sub(fullRun, 1, letters)

        local topPos = currentPos + Vector3.new(0, radius + 1.2, 0)
        local sTop, vTop = WorldToScreen(topPos)
        if vTop and #crackText.Text > 0 then
            crackText.Position = Vector2.new(sTop.X, sTop.Y)
            crackText.Visible = true
        else
            crackText.Visible = false
        end

        local crackAngles = { 0, 0.78, 1.57, 2.35, 3.14, 3.92, 4.71, 5.49 }
        for i = 1, 8 do
            local line = crackDrawings[i]
            local angle = crackAngles[i] + math.sin(elapsed * 20.0 + i) * 0.1
            local reach = radius * 0.95 * progress
            local p1w = currentPos
            local p2w = currentPos + Vector3.new(math.cos(angle) * reach, math.sin(angle * 1.5) * reach * 0.6, math.sin(angle) * reach)

            local s1, v1 = WorldToScreen(p1w)
            local s2, v2 = WorldToScreen(p2w)

            if v1 and v2 then
                line.From = Vector2.new(s1.X, s1.Y)
                line.To = Vector2.new(s2.X, s2.Y)
                line.Color = (i % 2 == 0) and Color3.fromRGB(20, 10, 10) or Color3.fromRGB(220, 20, 20)
                line.Visible = true
            else
                line.Visible = false
            end
        end

        if elapsed >= 3.0 then
            HideHeadDrawings()
            crackText.Visible = false
            animStage = "exploding"
            explodeStartTime = tick()
            for i = 1, 24 do
                local ang1 = (i / 24) * math.pi * 2
                local ang2 = (i % 6) * (math.pi / 3) - (math.pi / 6)
                local speed = 12.0 + (i % 7) * 3.5
                local dir = Vector3.new(math.cos(ang1) * math.cos(ang2), math.sin(ang2) + 0.6, math.sin(ang1) * math.cos(ang2)).Unit
                particlePool[i].Pos = ballPos
                particlePool[i].Vel = dir * speed
            end
            for i = 1, #crackDrawings do
                crackDrawings[i].Visible = false
            end
        end

    elseif animStage == "exploding" then
        HideHeadDrawings()
        crackText.Visible = false
        local elapsed = tick() - explodeStartTime
        local growth = math.min(1, elapsed / 0.75)
        local curScale = (1 - math.cos(growth * math.pi)) * 0.5 * BotSettings.Size

        for i = 1, 24 do
            local p = particlePool[i]
            p.Vel = p.Vel - Vector3.new(0, 25.0 * dt, 0)
            p.Pos = p.Pos + p.Vel * dt

            local sPos, onScreen = WorldToScreen(p.Pos)
            if onScreen and growth < 0.95 then
                p.Dot.Position = Vector2.new(sPos.X, sPos.Y)
                p.Dot.Color = p.Color
                p.Dot.Visible = true
            else
                p.Dot.Visible = false
            end
        end

        if curScale > 0.5 then
            Draw3DBillboardImage(ballPos, curScale, camPos, false)
        else
            HideBot()
        end

        if elapsed >= 0.75 then
            animStage = "idle"
            botPos = ballPos
            smoothDir = Vector3.new(0, 0, 1)
            chosenDir = Vector3.new(0, 0, 1)
            traversalSide = 0
            isWallFollowing = false
            botActive = true
            HideHeadDrawings()
            HideAnimationDrawings()
        end
    end
end

local players = game:GetService("Players")
local mouseState = { click = false, hold = false }

local function CheckMouseInput()
    local lp = players.LocalPlayer
    local mouse = lp and lp:GetMouse()
    if not mouse then return end

    local isDown = false
    if typeof(iskeypressed) == "function" then
        isDown = iskeypressed(0x01)
    end

    if isDown then
        if not mouseState.hold and not mouseState.click then
            mouseState.click = true
        else
            mouseState.click = false
        end
        mouseState.hold = true
    else
        mouseState.hold = false
        mouseState.click = false
    end

    if mouseState.click then
        local mx = mouse.X
        local my = mouse.Y
        local bx = btnBg.Position.X
        local by = btnBg.Position.Y
        local bw = btnBg.Size.X
        local bh = btnBg.Size.Y

        if mx >= bx and mx <= (bx + bw) and my >= by and my <= (by + bh) then
            TriggerButtonPress()
        end
    end
end

